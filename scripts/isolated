#!/bin/sh
set -eu

temporary_root="$(mktemp -d /tmp/opencode/unverse-check.XXXXXX)"
cleanup() {
  rm -rf "$temporary_root"
}
trap cleanup EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

export HOME="$temporary_root/home"
export XDG_CONFIG_HOME="$temporary_root/config"
export XDG_CACHE_HOME="$temporary_root/cache"
export XDG_DATA_HOME="$temporary_root/data"
export XDG_STATE_HOME="$temporary_root/state"
export XDG_RUNTIME_DIR="$temporary_root/runtime"
export TMPDIR="$temporary_root/tmp"
export npm_config_update_notifier=false
export npm_config_audit=false
export npm_config_fund=false
mkdir -p "$HOME" "$XDG_CONFIG_HOME" "$XDG_CACHE_HOME" "$XDG_DATA_HOME" "$XDG_STATE_HOME" "$XDG_RUNTIME_DIR" "$TMPDIR"
chmod 700 "$XDG_RUNTIME_DIR"

"$@"
