  ["graph-authentication", "dataverse/dependencies.js", 'error instanceof DataverseError && error.code === "authentication"', "false", "dataverse", "authentication failures stop dependency collection rather than yielding a partial success", "dependencies"],
  ["graph-connection-identity", "dataverse/dependencies.js", 'kind === "connection"', "false", "dataverse", "opaque connection identity is qualified by its connector binding", "dependencies"],
  ["graph-secret-fields", "dataverse/connections.js", "statecode,ismanaged", "statecode,ismanaged,connectionparametersconfig", "dataverse", "connection metadata excludes credentials and separates bindings from dependencies", "dependencies"],
  ["graph-label-identity", "dataverse/dependencies.js", "guid(text(row, key)) !== node.objectId", "false", "dataverse", "unrelated label metadata cannot invent a connection binding", "dependencies"],
);

for (const [name, file, before, after, workspace, testName, namedFile] of mutations) {
  const temporary = mkdtempSync("/tmp/opencode/unverse-mutation-");
  try {
    cpSync(resolve(root, "packages"), resolve(temporary, "packages"), { recursive: true });
    cpSync(resolve(root, "scripts/lib"), resolve(temporary, "scripts/lib"), { recursive: true });
    mkdirSync(resolve(temporary, "node_modules/@unverse"), { recursive: true });
    for (const entry of readdirSync(resolve(root, "node_modules"))) {
      if (entry !== "@unverse") symlinkSync(resolve(root, "node_modules", entry), resolve(temporary, "node_modules", entry));
    }
    for (const entry of readdirSync(resolve(temporary, "packages"))) symlinkSync(resolve(temporary, "packages", entry), resolve(temporary, "node_modules/@unverse", entry));
    const target = resolve(temporary, "packages", file.replace("/", "/dist/"));
    const source = readFileSync(target, "utf8");
    assert.ok(source.includes(before), `Mutation ${name} has no target.`);
    writeFileSync(target, source.replace(before, after));
    const isolated = {};
    for (const variable of ["HOME", "XDG_CONFIG_HOME", "XDG_CACHE_HOME", "XDG_DATA_HOME", "XDG_STATE_HOME", "XDG_RUNTIME_DIR", "TMPDIR"]) {
      isolated[variable] = resolve(temporary, variable);
      mkdirSync(isolated[variable]);
    }
    const testFile = namedFile ?? (workspace === "core" ? "config" : workspace === "cli" ? "run" : "client");
    const result = spawnSync(process.execPath, ["--test", `--test-name-pattern=^${testName}$`, `packages/${workspace}/test/${testFile}.test.mjs`], { cwd: temporary, encoding: "utf8", env: { ...process.env, ...isolated }, timeout: 30_000 });
    const transcript = result.stdout + result.stderr;
    assert.equal(result.status, 1, `Mutation ${name} survived or crashed:\n${transcript}`);
    assert.match(transcript, /AssertionError|ERR_ASSERTION/, `Mutation ${name} did not fail a behaviour assertion:\n${transcript}`);
    assert.ok(transcript.includes(testName), `Mutation ${name} did not run its named test.`);
    console.log(`Proven: ${name} -> ${testName}`);
  } finally {
    rmSync(temporary, { recursive: true, force: true });
  }
}
