  ["graph-typed-id", "dataverse/dependencies.js", "`component:${componentType(type)}:${guid(objectId)}`", "`component:0:${guid(objectId)}`", "dataverse", "typed component identity prevents same-GUID nodes from merging", "dependencies"],
  ["graph-direction", "dataverse/dependencies.js", 'from,\n                                to,\n                                kind: "requires"', 'from: to,\n                                to: from,\n                                kind: "requires"', "dataverse", "dependency graph keeps consumer-to-requirement direction and transitive impact paths", "dependencies"],
